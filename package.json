{
  "name": "portal-fiap",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "build:api": "npm run build -w api",
    "start:api": "npm run start -w api",
    "dev:frontend": "npm run dev -w frontend",
    "build:frontend": "npm run build -w frontend",
    "start:frontend": "npm run start -w frontend",
    "test": "npm test -w api",
    "lint": "npm run lint -w api",
    "migrate:up": "npm run migrate:up -w api",
    "migrate:down": "npm run migrate:down -w api",
    "seed": "npm run seed -w api"
  }
}
