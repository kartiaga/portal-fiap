PORT=3000
NODE_ENV=development

# Database (desenvolvimento local — API fora do Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5431
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portal-fiap

# Database URL (usada pelas migrations)
DATABASE_URL=postgres://postgres:postgres@localhost:5431/portal-fiap

# JWT Secret (mínimo 32 caracteres; evite o caractere $)
JWT_SECRET=sua-chave-secreta-com-pelo-menos-32-caracteres

# Fotos de perfil (opcional): MinIO do docker-compose. Sem estas variáveis a API funciona,
# mas as rotas de foto respondem 503.
# S3_ENDPOINT é como a API alcança o MinIO; S3_PUBLIC_URL é como o app o alcança
# (localhost no simulador do iOS, 10.0.2.2 no emulador do Android, o IP da máquina em aparelho físico).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=portal-fiap
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
