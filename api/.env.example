PORT=3000
NODE_ENV=development

# Database (desenvolvimento local — API fora do Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5431
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portal-fiap

# Database URL (usada pelas migrations)
DATABASE_URL=postgres://postgres:postgres@localhost:5431/portal-fiap

# JWT Secret (mínimo 32 caracteres; evite o caractere $)
JWT_SECRET=sua-chave-secreta-com-pelo-menos-32-caracteres
